# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=virtualcompany_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Backend Server
SERVER_PORT=8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# GitHub OAuth: GitHub Settings > Developer settings > OAuth Apps > your app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/github/callback
# On Windows the startup script automatically loads the existing encrypted key
# from %LOCALAPPDATA%/DevSim/github-token-key.xml if this is unset.
# Otherwise set the original Base64-encoded 32-byte key here. Never rotate on restart.
# GITHUB_TOKEN_KEY=

# Optional Gemini AI (get the key from Google AI Studio)
# GEMINI_API_KEY=
# GEMINI_MODEL=your-available-model-id

# Optional repository template; omit to create a README-only starter repository.
# GITHUB_TEMPLATE_REPO=owner/template-repository
# GITHUB_REPO_MODE=TEMPLATE

# Optional AI review bot (a separate GitHub App)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY_FILE=C:\secure\devsim-app-pkcs8.pem

# Optional public webhook; local manual Sync PRs works without this.
# GITHUB_WEBHOOK_URL=https://your-tunnel/api/v1/github/webhook
# GITHUB_WEBHOOK_SECRET=
